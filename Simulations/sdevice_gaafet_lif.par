#define ParFileDir .

Material="HfO2" {
  #includeext "ParFileDir/HfO2.par"
}

Material="Silicon" {
    #includeext "ParFileDir/Silicon.par"

    ConstantMobility { * Correct placement: 'ConstantMobility' directly under 'Material'
        mumax = 300, 470.5 * electron mobility 300 cm2/(V s), default for holes
        Exponent = 2.5, 2.2
    }

    * --- Impact Ionization for LIF Neuron Firing (from Workflow.md Section 3.3) ---
    * Using built-in University of Bologna (UniBo) model to avoid missing PMI error.
    * Mapping 'd0' (pre-factor) from Workflow to 'a' parameter in UniBo model.
    Avalanche_UniBo {
        a(0) = 1.0e6    * [1/cm] Electron ionization pre-factor (d0_e equivalent)
        a(1) = 1.0e6    * [1/cm] Hole ionization pre-factor (d0_h equivalent)
        * b parameters left as default or implicitly defined by material properties
    }
}

Material="TiN" {
  #includeext "ParFileDir/TiN.par"
}

* --- Define HZO as an Insulator based on HfO2 ---
Material="HZO" {
  #includeext "ParFileDir/HfO2.par"

  * --- Physical Parameters ---
  * NOTE: Values from Workflow.md and general HZO literature.

  Epsilon {
    epsilon = 25.0      * Relative permittivity (eps_r)
  }
  BandGap {
    Chi0 = 2.0          * Electron Affinity [eV]
    Eg0 = 5.2           * Band Gap [eV] at 0 K (Often used as a base for 300 K)
  }

FEPolarization
{ * FEPolarization parameters for L-K equation (from Workflow.md)
	alpha	= -9.889e10	# [cm/F]
	beta	= 2.007e19	# [cm^5/(FC^2)]
	gamma	= 0	# [cm^9/(FC^4)]
}

}