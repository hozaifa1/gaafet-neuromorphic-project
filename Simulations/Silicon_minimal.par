* Minimal Silicon parameter file for UniBo2 impact ionization testing
* Based on Sentaurus default Silicon.par with only essential parameters

Epsilon {
    epsilon = 11.7
}

Lattice {
    * Lattice constants
    * T = T0: a() = a0 + a1 * (T/T0 - 1)
    T0 = 300
    a0 = 5.431e-8
    a1 = 1.8138e-10
}

Bandgap {
    * Eg = Eg0 + dEg
    * dEg = alpha * (T - T0)
    Chi0 = 4.17
    Eg0 = 1.12
    alpha = -2.84e-4
    Tpar = 0
    * Band gap narrowing:
    * dEg_BGN = - dEg0 - dEg1 * (N/N0)^(dEg2) for N > Nref
    dEg0 = 0
    dEg1 = 0
    N0 = 1.0e17
    dEg2 = 0.5
    Nref = 0
}

EffectiveIntrinsicDensity {
    * Nie^2 = Nc * Nv * exp(-Eg/(kB*T)) * F(T)
    * with F = (T/T0)^gamma, Nc(T0), Nv(T0)
    * Nc(T0) = Nc300 * (me/m0)^1.5
    * Nv(T0) = Nv300 * (mh/m0)^1.5
    T0 = 300
    Nc300 = 3.21667e19
    Nv300 = 1.82868e19
    me = 1.08
    mh = 1.15
    gamma = 0
}

Scharfetter {
    * SRH recombination
    * tau = taumin + (taumax - taumin) / (1 + (N/Nref)^gamma)
    taumin = 0, 0
    taumax = 1e-5, 3e-6
    Nref = 1e16, 1e16
    gamma = 1, 1
    Talpha = -1.5, -1.5
    Tcoeff = 2.55, 2.55
    Etrap = 0
}

Auger {
    * Auger recombination
    * R_Auger = (Cn*n + Cp*p) * (n*p - nie^2)
    Cn = 2.8e-31
    Cp = 9.9e-32
}

AvalancheFactors {
    * Coefficients for avalanche generation with hydrodynamic
    * Effective electric field scaling
    n_l_f = 1
    p_l_f = 1
    n_gamma = 1
    p_gamma = 1
    n_delta = 1.5
    p_delta = 1.5
}

EnergyRelaxationTime {
    * Energy relaxation times in picoseconds
    (tau_w)_ele = 0.2
    (tau_w)_hol = 0.2
}

UniBo2 {
    * University of Bologna impact ionization model
    * DEFAULT VALUES - will be overridden by user's values
    * electron parameters
    a0_e = 4.65403
    a1_e = -8.76031e-3
    a2_e = 1.34037e-5
    a3_e = -2.75108e-9
    b0_e = -0.128302
    b1_e = 4.45552e-3
    b2_e = -1.0866e-5
    b3_e = 9.23119e-9
    b4_e = -1.82482e-12
    b5_e = -4.82689e-15
    b6_e = 1.09402e-17
    b7_e = -1.24961e-20
    b8_e = 7.55584e-24
    b9_e = -2.28615e-27
    b10_e = 2.73344e-31
    c0_e = 7.76221e3
    c1_e = 25.18888
    c2_e = -1.37417e-3
    c3_e = 1.59525e-4
    d0_e = 7.10481e5
    d1_e = 3.98594e3
    d2_e = -7.19956
    d3_e = 6.96431e-3
    
    * hole parameters
    a0_h = 2.26018
    a1_h = 0.0134001
    a2_h = -5.87724e-6
    a3_h = -1.14021e-9
    b0_h = 0.058547
    b1_h = -1.95755e-4
    b2_h = 2.44357e-7
    b3_h = -1.33202e-10
    b4_h = 2.68082e-14
    b5_h = 0.0
    b6_h = 0.0
    b7_h = 0.0
    b8_h = 0.0
    b9_h = 0.0
    b10_h = 0.0
    c0_h = 1.95399e4
    c1_h = -104.441
    c2_h = 0.498768
    c3_h = 0.0
    d0_h = 2.07712e6
    d1_h = 993.153
    d2_h = 7.77769
    d3_h = 0.0
}
