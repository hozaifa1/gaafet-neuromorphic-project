#define ParFileDir .

* === Phase 1D — H2C "lowEc" reduced coercive field ===
* P_r = 20 µC/cm², P_s = 24 µC/cm², F_c = 0.9 MV/cm.
* Tests whether wider MW is achievable per volt of program by
* lowering F_c (more switching at the H1-chosen low V_pgm).

Material="HfO2" {
  #includeext "ParFileDir/HfO2.par"
}

Material="Silicon" {
    #includeext "ParFileDir/Silicon.par"

    ConstantMobility {
        mumax = 300, 470.5
        Exponent = 2.5, 2.2
    }

    Band2BandTunneling {
        Agen = 4.0e14
        Bgen = 1.9e7
        Pgen = 2.5
        Arec = 4.0e14
        Brec = 1.9e7
        Prec = 2.5
        alpha = 0
    }
}

Material="TiN" {
  #includeext "ParFileDir/TiN.par"
}

Material="HZO" {
  #includeext "ParFileDir/HfO2.par"

  Epsilon {
    epsilon = 33.0
  }
  BandGap {
    Chi0 = 2.0
    Eg0 = 5.2
  }

  Polarization {
    * H2C: lower F_c (0.9 MV/cm), Lizzit P_r
    P_r = (0, 2.0e-5, 0)
    P_s = (0, 2.4e-5, 0)
    F_c = (0, 0.9e6, 0)

    tau_E = (0, 1e-6, 0)
    tau_P = (0, 1e-5, 0)
    kn    = (0, 0, 0)
  }
}
